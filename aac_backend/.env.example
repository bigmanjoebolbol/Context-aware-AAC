# Configure one or more providers below. Only providers with a key set
# will show up in GET /providers and be selectable by the app.

# --- Groq (fast/cheap Llama models) - https://console.groq.com/ ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini - https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# --- Claude - https://console.anthropic.com/settings/keys ---
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Which provider id to use when the app doesn't specify one.
# Falls back to the first configured provider if unset or unavailable.
DEFAULT_PROVIDER=groq

# Optional: set this to any random string, and send the same value as
# the x-app-key header from the Flutter app, so only your app can call
# this endpoint. Leave blank while testing locally.
APP_SHARED_SECRET=

# Tuning
MAX_TOKENS=150
PROVIDER_TIMEOUT_MS=7000

PORT=8080
