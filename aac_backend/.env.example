# Configure one or more providers below. Only providers with a key set
# will show up in GET /providers and be used by the backend.

# --- Gemini (Google AI Studio — free tier available) ---
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# --- Groq (fast/cheap Llama models) ---
# Get key: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Claude (Anthropic) ---
# Get key: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Ollama (local LLM, no API key needed) ---
# Install: https://ollama.com/download
# Pull a model first: ollama pull qwen2.5:1.5b
# Then start the server: ollama serve
# Setting OLLAMA_MODEL enables this provider. Leave blank to disable.
OLLAMA_MODEL=qwen2.5:1.5b
# Override the Ollama server address if not on localhost:
# OLLAMA_BASE_URL=http://localhost:11434

# Which provider id to use when the app doesn't specify one.
# Falls back to the first configured provider if unset or unavailable.
# Options: gemini | groq | claude | ollama
DEFAULT_PROVIDER=gemini

# Optional shared secret — set this to any random string and send the same
# value as the x-app-key header from the Flutter app, so only your app
# can call this endpoint. Leave blank while testing locally.
APP_SHARED_SECRET=

# Tuning
MAX_TOKENS=150
PROVIDER_TIMEOUT_MS=7000

PORT=8080
